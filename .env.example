# Copy to .env.local for development. On Vercel: Project → Settings → Environment Variables (all environments that should talk to Convex).

# Convex deployment URL (Dashboard → Deployment → Settings, or output of `npx convex dev`)
NEXT_PUBLIC_CONVEX_URL=https://your-deployment-name.convex.cloud

# Clerk (required for auth)
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# CLERK_SECRET_KEY=

# AI (optional — server-only on Vercel)
# GEMINI_API_KEY=

# Unsplash (optional)
# NEXT_PUBLIC_UNSPLASH_ACCESS_KEY=
